{
  "expo": {
    "name": "Melo",
    "slug": "pausepal-expo",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.example.melo"
    },
    "android": {
      "package": "com.example.melo",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F8F4EF"
      }
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Melo to select a photo only when you choose to attach one to your AI provider.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}
